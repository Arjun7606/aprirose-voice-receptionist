{
  "name": "aprirose-receptionist",
  "main": "worker.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "VOICE_LIMITER",
      "namespace_id": "1042",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
}
